{
  "schemaVersion": 1,
  "id": "ancientsmod",
  "version": "${version}",
  "name": "AncientsMod",
  "description": "Client-side companion mod for the Ancients Minecraft network (ancients.gg). Renders HUDs, floating point numbers, pings, and other visuals. Purely cosmetic — server remains authoritative for all gameplay.",
  "authors": ["Aleks"],
  "contact": {
    "homepage": "https://ancients.gg",
    "sources": "https://github.com/alekswoje/AncientsMod",
    "issues": "https://github.com/alekswoje/AncientsMod/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.aleks.ancientsmod.client.AncientsModClient"
    ]
  },
  "mixins": [
    "ancientsmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "breaks": {
    "prisonsmod": "*"
  }
}
